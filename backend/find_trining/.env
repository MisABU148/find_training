# --- App ---
APP_NAME=coach-app
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=default

# --- Database (фактор IV) ---
DB_URL=jdbc:postgresql://localhost:5432/appdb
DB_USERNAME=app
DB_PASSWORD=app
POSTGRES_DB=appdb
DB_POOL_MAX=10
DB_POOL_MIN=2

# --- JPA / Flyway ---
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true

# --- JWT (фактор III: секрет только через env) ---
JWT_SECRET=replace-with-32+-byte-random-string
JWT_TTL=PT1H
JWT_ISSUER=coach-app

# --- Logs ---
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG